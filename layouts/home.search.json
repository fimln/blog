{{- $posts := slice -}}
{{- range (where site.RegularPages "Section" "posts").ByDate.Reverse -}}
  {{- $posts = $posts | append (dict "title" .Title "url" .RelPermalink "date" (.Date.Format "2006-01-02T15:04:05Z07:00") "dateLabel" (.Date.Format "02 Jan 2006") "tags" (delimit (.Params.tags | default slice) " ") "categories" (delimit (.Params.categories | default slice) " ") "excerpt" (partial "excerpt.html" .) "content" (.Plain | htmlUnescape | strings.TrimSpace | replaceRE `\s+` " ")) -}}
{{- end -}}
{{- $posts | jsonify -}}
